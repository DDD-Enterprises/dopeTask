{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dopetask.dev/schemas/series_context.schema.json",
  "title": "dopeTask TP Series Context",
  "description": "Packet dependency context written by src/dopetask/ops/tp_series/logic.py as SERIES_CONTEXT.json.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "series_id",
    "tp_id",
    "parent_tp_id",
    "depends_on",
    "dependencies"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "1.0"
    },
    "series_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "tp_id": {
      "type": "string",
      "minLength": 1
    },
    "parent_tp_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "depends_on": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "dependencies": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/dependency_record"
      }
    },
    "worktree_context": {
      "type": "string",
      "minLength": 1
    }
  },
  "$defs": {
    "dependency_record": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "branch",
        "head_sha",
        "status",
        "run_dir"
      ],
      "properties": {
        "branch": {
          "type": [
            "string",
            "null"
          ]
        },
        "head_sha": {
          "type": [
            "string",
            "null"
          ]
        },
        "status": {
          "type": [
            "string",
            "null"
          ]
        },
        "run_dir": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    }
  }
}
