  "documented_shape_inconsistencies": [
    {
      "surface": "ROUTE_PLAN.json design prose vs runtime writer",
      "observation": "TUI_DATA_ARCHITECTURE.md names planned-step fields step_id and top_candidates, but src/dopetask/router/reporting.py emits step and candidates_top3.",
      "resolution": "route_plan.schema.json follows route_plan_to_dict() because runtime code is higher authority than design prose."
    },
    {
      "surface": "Historical EXEC.json fixtures vs current runtime writer",
      "observation": "Existing out/tp_series EXEC.json fixtures lack agent, model, requested_model, effective_model, and effective_model_source even though current logic.py writes them.",
      "resolution": "exec_record.schema.json models those metadata fields as optional to preserve historical artifact validation without inventing auth metadata."
    },
    {
      "surface": "SERIES_CONTEXT.json file vs returned context payload",
      "observation": "_write_series_context() writes SERIES_CONTEXT.json before adding worktree_context to the returned payload used inside EXEC.context.",
      "resolution": "series_context.schema.json allows optional worktree_context while not requiring it for standalone SERIES_CONTEXT.json fixtures."
    }
